# 复制为 .env 后填入真实值；.env 已被 gitignore，不会入库
APP_ENV=dev
HTTP_ADDR=:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=family_points

JWT_SECRET=CHANGE_ME

# 默认管理员（仅初始化时使用；已存在管理员则跳过）
ADMIN_USERNAME=admins
ADMIN_PASSWORD=CHANGE_ME

# Token 有效期：Access 2h + Refresh 30d
ACCESS_TTL=2h
REFRESH_TTL=720h
