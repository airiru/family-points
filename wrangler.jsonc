{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-points",
  "main": "worker/index.js",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Vite 构建产物；未命中静态资源的请求（即 /api/*）进入 worker/index.js
    "directory": "./dist"
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d6963179250941a596f76d5eba51a74e"
    }
  ]
}
